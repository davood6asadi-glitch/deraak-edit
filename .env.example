# کلید وب‌سرویس کاوه‌نگار (دریافت از پنل کاوه‌نگار -> حساب من -> بخش تنظیمات API)
KAVENEGAR_API_KEY=

# نام الگوی اعتبارسنجی (Verify Lookup) برای ارسال کد تایید به کاربر
# نمونه متن الگو در کاوه‌نگار: کد تایید درخواست مشاوره دراک: %token
KAVENEGAR_OTP_TEMPLATE=derak-verify

# نام الگوی اعتبارسنجی (Verify Lookup) برای ارسال خلاصه درخواست مشاوره به مدیر سایت
# نمونه متن الگو در کاوه‌نگار: درخواست مشاوره جدید از %token2 با شماره %token برای تجهیز %token3 ثبت شد.
KAVENEGAR_ADMIN_TEMPLATE=derak-admin-lead

# شماره موبایل مدیر سایت جهت دریافت پیامک درخواست‌های مشاوره
KAVENEGAR_ADMIN_PHONE=09398058002

# کلید رمزنگاری امضای توکن کد تایید در سمت سرور
OTP_SECRET=
